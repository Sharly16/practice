apiVersion: v1
kind: Pod
metadata:
  name: good-pod
  namespace: volume-demo
spec:
  initContainers:
  - name: fix-permission
    image: busybox
    command: ["sh", "-c", "chown 1000:1000 /data && chmod 770 /data"]
    securityContext:
      runAsUser: 0
    volumeMounts:
    - name: pvc
      mountPath: /data

  containers:
  - name: writer
    image: busybox
    command: ["sh", "-c", "sleep 3600"]
    securityContext:
      runAsUser: 1000
      runAsGroup: 1000
    volumeMounts:
    - name: pvc
      mountPath: /data

  volumes:
  - name: pvc
    persistentVolumeClaim:
      claimName: demo-pvc
