%sql

CREATE TABLE ltmirun25_p1d6_schema_evolution (
    order_id INT,
    customer_id STRING,
    amount DOUBLE
)
USING DELTA;

%sql

INSERT INTO ltmirun25_p1d6_schema_evolution VALUES
(1, 'C001', 500.0),
(2, 'C002', 750.0),
(3, 'C003', 1000.0);

%sql

SELECT *
FROM ltmirun25_p1d6_schema_evolution;


from pyspark.sql import Row

new_data = [
    Row(order_id=4, customer_id="C004", amount=1200.0, discount=10.0),
    Row(order_id=5, customer_id="C005", amount=1500.0, discount=15.0)
]

df = spark.createDataFrame(new_data)

df.write \
    .format("delta") \
    .mode("append") \
    .option("mergeSchema", "true") \
    .saveAsTable("ltmirun25_p1d6_schema_evolution")



%sql

DESCRIBE TABLE ltmirun25_p1d6_schema_evolution;


%sql

SELECT *
FROM ltmirun25_p1d6_schema_evolution
