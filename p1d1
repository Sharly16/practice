from datetime import datetime

from airflow.decorators import dag, task


@dag(
    dag_id="sharlypricilla-albertwilson-p1d5_taskflow_dag",
    schedule=None,
    start_date=datetime(2023, 1, 1),
    catchup=False,
)
def taskflow_pipeline():

    @task
    def extract_data():
        return {
            "order_id": 101,
            "amount": 250
        }

    @task
    def transform_data(raw_data):
        transformed_data = {
            "order_id": raw_data["order_id"],
            "amount": raw_data["amount"],
            "status": "processed"
        }
        return transformed_data

    @task
    def load_data(transformed_data):
        print(f"Loaded data: {transformed_data}")

    raw = extract_data()
    processed = transform_data(raw)
    load_data(processed)


dag_instance = taskflow_pipeline()
