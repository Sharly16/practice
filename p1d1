USE ROLE RETAIL_ENGINEER_123;
USE WAREHOUSE RETAIL_WH123;
USE SCHEMA RETAIL_DB.RAW;

CREATE OR REPLACE TABLE REGION123 AS
SELECT *
FROM SNOWFLAKE_SAMPLE_DATA.TPCH_SF1.REGION;



CREATE OR REPLACE TABLE RETAIL_DB.ANALYTICS.ORDER_SUMMARY AS
SELECT
    o.O_ORDERKEY,
    o.O_ORDERDATE,
    o.O_TOTALPRICE,
    o.O_ORDERPRIORITY,
    c.C_MKTSEGMENT,
    n.N_NAME AS NATION
FROM RETAIL_DB.RAW.ORDERS o
JOIN RETAIL_DB.RAW.CUSTOMER c
    ON c.C_CUSTKEY = o.O_CUSTKEY
JOIN RETAIL_DB.RAW.NATION n
    ON n.N_NATIONKEY = c.C_NATIONKEY;

