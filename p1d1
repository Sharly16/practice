ALTER SESSION SET QUERY_TAG = 'lab123_q1';

SELECT
    L_RETURNFLAG,
    L_LINESTATUS,
    SUM(L_QUANTITY) AS SUM_QTY,
    SUM(L_EXTENDEDPRICE * (1 - L_DISCOUNT)) AS SUM_DISC_PRICE,
    AVG(L_DISCOUNT) AS AVG_DISC,
    COUNT(*) AS COUNT_ORDER
FROM RETAIL_DB.RAW.LINEITEM123
WHERE L_SHIPDATE <= DATEADD(DAY, -90, DATE '1998-12-01')
GROUP BY 1, 2
ORDER BY 1, 2;

SELECT
    QUERY_TAG,
    COMPILATION_TIME,
    QUEUED_PROVISIONING_TIME,
    EXECUTION_TIME,
    TOTAL_ELAPSED_TIME,
    BYTES_SCANNED
FROM TABLE(
    INFORMATION_SCHEMA.QUERY_HISTORY_BY_SESSION(RESULT_LIMIT => 100)
)
WHERE QUERY_TAG = 'lab3_q1'
  AND QUERY_TYPE = 'SELECT'
ORDER BY START_TIME DESC
LIMIT 1;


ALTER SESSION SET QUERY_TAG = 'sharly_q3';

SELECT
    l.L_ORDERKEY,
    SUM(l.L_EXTENDEDPRICE * (1 - l.L_DISCOUNT)) AS REVENUE,
    o.O_ORDERDATE,
    o.O_SHIPPRIORITY
FROM RETAIL_DB.RAW.CUSTOMER123 c
JOIN RETAIL_DB.RAW.ORDERS123 o
    ON c.C_CUSTKEY = o.O_CUSTKEY
JOIN RETAIL_DB.RAW.LINEITEM123 l
    ON l.L_ORDERKEY = o.O_ORDERKEY
WHERE c.C_MKTSEGMENT = 'BUILDING'
  AND o.O_ORDERDATE < DATE '1995-03-15'
  AND l.L_SHIPDATE > DATE '1995-03-15'
GROUP BY l.L_ORDERKEY, o.O_ORDERDATE, o.O_SHIPPRIORITY
ORDER BY REVENUE DESC, o.O_ORDERDATE
LIMIT 10;

ALTER SESSION SET QUERY_TAG = 'sharly_trend';

SELECT
    DATE_TRUNC('MONTH', O_ORDERDATE) AS MONTH,
    ROUND(SUM(O_TOTALPRICE), 2) AS REVENUE,
    ROUND(
        SUM(SUM(O_TOTALPRICE)) OVER (
            ORDER BY DATE_TRUNC('MONTH', O_ORDERDATE)
        ),
        2
    ) AS RUNNING_TOTAL
FROM RETAIL_DB.ANALYTICS.ORDER_SUMMARY
WHERE O_ORDERDATE >= DATE '1997-01-01'
  AND O_ORDERDATE < DATE '1998-01-01'
GROUP BY 1
ORDER BY 1;


SELECT QUERY_ID,
       LEFT(QUERY_TEXT, 60) AS QUERY_START,
       QUERY_TAG,
       WAREHOUSE_SIZE,
       ROUND(TOTAL_ELAPSED_TIME / 1000, 1) AS SECONDS,
       ROUND(BYTES_SCANNED / POWER(1024, 3), 2) AS GB_SCANNED,
       ROUND(
           TOTAL_ELAPSED_TIME / 1000 / 3600 *
           CASE WAREHOUSE_SIZE
               WHEN 'X-Small' THEN 1
               WHEN 'Small' THEN 2
               WHEN 'Medium' THEN 4
               WHEN 'Large' THEN 8
               ELSE NULL
           END,
           5
       ) AS EST_CREDITS
FROM TABLE(
    INFORMATION_SCHEMA.QUERY_HISTORY_BY_WAREHOUSE(
        WAREHOUSE_NAME => 'RETAIL_WH123',
        RESULT_LIMIT => 1000
    )
)
WHERE QUERY_TYPE = 'SELECT'
  AND EXECUTION_STATUS = 'SUCCESS'
ORDER BY TOTAL_ELAPSED_TIME DESC
LIMIT 5;


