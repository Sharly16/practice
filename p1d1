import json
import os
from kafka import KafkaProducer

BOOTSTRAP_SERVERS = os.getenv("KAFKA_BOOTSTRAP_SERVERS", "localhost:9092")
TOPIC_NAME = "events-stream-sharlypricilla-albertwilson-p1d4"


def run_producer():
    print(f"[INFO] Initializing Kafka Producer for topic: {TOPIC_NAME}")

    producer = KafkaProducer(
        bootstrap_servers=BOOTSTRAP_SERVERS,
        value_serializer=lambda value: json.dumps(value).encode("utf-8")
    )

    alerts = [
        {
            "alert_id": "ALT-1001",
            "event_type": "security_alert",
            "severity": "HIGH",
            "message": "Suspicious login activity detected"
        },
        {
            "alert_id": "ALT-1002",
            "event_type": "login_failure",
            "severity": "MEDIUM",
            "message": "Multiple failed login attempts detected"
        },
        {
            "alert_id": "ALT-1003",
            "event_type": "security_alert",
            "severity": "LOW",
            "message": "Unusual account activity detected"
        }
    ]

    for alert in alerts:
        producer.send(TOPIC_NAME, value=alert)
        print(f"[INFO] Published: {alert}")

    producer.flush()
    producer.close()

    print("[INFO] All security alerts published successfully.")


if __name__ == "__main__":
    run_producer()
