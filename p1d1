import json
import os
import sys
from kafka import KafkaConsumer

BOOTSTRAP_SERVERS = os.getenv(
    "KAFKA_BOOTSTRAP_SERVERS",
    "localhost:29092"
)

GROUP_ID = "alerts-group-sharlypricilla-albertwilson-p1d4"
TOPIC_NAME = "events-stream-sharlypricilla-albertwilson-p1d4"


def run_consumer():
    """
    Connect to Kafka as part of GROUP_ID, consume messages from TOPIC_NAME,
    and commit offsets.
    """

    print("[INFO] Initializing Kafka Consumer...")
    print(f"[INFO] Consumer Group: {GROUP_ID}")
    print(f"[INFO] Subscribing to Topic: {TOPIC_NAME}")

    consumer = KafkaConsumer(
        TOPIC_NAME,
        bootstrap_servers=BOOTSTRAP_SERVERS,
        group_id=GROUP_ID,
        auto_offset_reset="earliest",
        enable_auto_commit=False,
        value_deserializer=lambda value: json.loads(
            value.decode("utf-8")
        ),
        consumer_timeout_ms=5000
    )

    consumed_count = 0

    for message in consumer:
        print(
            f"[INFO] Consumed: "
            f"topic={message.topic}, "
            f"partition={message.partition}, "
            f"offset={message.offset}, "
            f"value={message.value}"
        )
        consumed_count += 1

    if consumed_count > 0:
        consumer.commit()
        print(
            f"[INFO] Successfully committed offsets "
            f"after consuming {consumed_count} message(s)."
        )
    else:
        print("[INFO] No new messages available.")

    consumer.close()
    print("[INFO] Kafka consumer closed.")


if __name__ == "__main__":
    run_consumer()
