apiVersion: v1
kind: Pod
metadata:
  name: bad-pod
  namespace: volume-demo

spec:
  initContainers:
  - name: set-bad-permission
    image: busybox
    command: ["sh", "-c", "chown 0:0 /data && chmod 700 /data"]
    securityContext:
      runAsUser: 0
    volumeMounts:
    - name: pvc
      mountPath: /data

  containers:
  - name: writer
    image: busybox
    command: ["sh", "-c", "sleep 3600"]
    securityContext:
      runAsUser: 1000
    volumeMounts:
    - name: pvc
      mountPath: /data

  volumes:
  - name: pvc
    persistentVolumeClaim:
      claimName: demo-pvc

